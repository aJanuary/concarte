{
  "name": "@concarte/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && concurrently -k -n generate,next \"pnpm generate:watch\" \"next dev\"",
    "build": "pnpm generate && next build",
    "start": "next start",
    "generate": "tsx scripts/generate.ts",
    "generate:watch": "tsx watch --include \"../events/**/*\" scripts/generate.ts",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "generate:config": "tsx scripts/generate-config.ts",
    "generate:theme": "tsx scripts/generate-theme-css.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@concarte/core": "workspace:*",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "fuse.js": "^7.5.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "svg-pathdata": "^9.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
