{
  "name": "concarte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && concurrently -k -n generate,next \"pnpm generate:watch\" \"next dev\"",
    "build": "pnpm generate && next build",
    "start": "next start",
    "generate": "tsx scripts/generate.ts",
    "generate:watch": "tsx watch --include \"events/**/*\" scripts/generate.ts",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "generate:config": "tsx scripts/generate-config.ts",
    "generate:theme": "tsx scripts/generate-theme-css.ts",
    "editor": "vite --config tools/editor/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "precommit": "lint-staged",
    "prepare": "husky",
    "editor:build": "tsx scripts/build-editor-app.ts",
    "editor:app": "pnpm editor:build && electron build/editor/main.mjs",
    "editor:package": "tsx scripts/package-editor.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "fuse.js": "^7.1.0",
    "linkedom": "^0.18.13",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "ol": "^10.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "svg-pathdata": "^8.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.2.1",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-resizable-panels": "^4.18.1",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": [
      "eslint --no-warn-ignored --max-warnings=0",
      "prettier --write --ignore-unknown"
    ]
  }
}
