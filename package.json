{
  "name": "concarte",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @concarte/site dev",
    "build": "pnpm --filter @concarte/site build",
    "start": "pnpm --filter @concarte/site start",
    "generate": "pnpm --filter @concarte/site generate",
    "editor:build": "pnpm --filter @concarte/editor build",
    "editor:app": "pnpm --filter @concarte/editor app",
    "editor:package": "pnpm --filter @concarte/editor package",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark": "^15.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": [
      "eslint --no-warn-ignored --max-warnings=0",
      "prettier --write --ignore-unknown"
    ]
  }
}
