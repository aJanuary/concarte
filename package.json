{
  "name": "concarte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm generate && concurrently -k -n generate,next \"pnpm generate:watch\" \"next dev\"",
    "build": "pnpm generate && next build",
    "start": "next start",
    "generate": "tsx scripts/generate.ts",
    "generate:watch": "tsx watch --include \"events/**/*\" scripts/generate.ts",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "generate:config": "tsx scripts/generate-config.ts",
    "generate:theme": "tsx scripts/generate-theme-css.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "fuse.js": "^7.5.0",
    "linkedom": "^0.18.15",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "svg-pathdata": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark": "^15.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": [
      "eslint --no-warn-ignored --max-warnings=0",
      "prettier --write --ignore-unknown"
    ]
  }
}
